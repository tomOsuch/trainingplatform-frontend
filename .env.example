# Zmienne środowiskowe frontendu.
# Skopiuj do .env.local, jeśli potrzebujesz wartości innych niż domyślne.
#
# Uwaga: Create React App wstrzykuje te wartości podczas budowania (npm run build),
# a nie w czasie działania. Zmiana adresu API wymaga ponownego zbudowania aplikacji.

# Adres backendu wraz z prefiksem /api.
# Lokalnie: http://localhost:8080/api
REACT_APP_API_URL=
